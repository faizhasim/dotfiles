#!/usr/bin/env bash
set -euo pipefail

# ── Nix (nixfmt + statix) ──────────────────────────────────────────────────

# Collect staged .nix files (added, copied, modified, renamed)
nix_files=()
while IFS= read -r -d '' file; do
    nix_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.nix')

if [ ${#nix_files[@]} -gt 0 ]; then
    # Format each staged .nix file and re-stage
    for f in "${nix_files[@]}"; do
        nixfmt "$f"
        git add "$f"
    done

    # Lint staged .nix files
    for f in "${nix_files[@]}"; do
        statix check "$f"
    done
fi

# ── Shell scripts ──────────────────────────────────────────────────────────

sh_files=()
while IFS= read -r -d '' file; do
    sh_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/**/*.sh')

for f in "${sh_files[@]}"; do
    shellcheck "$f"
done

# ── Markdown ───────────────────────────────────────────────────────────────

md_files=()
while IFS= read -r -d '' file; do
    md_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md')

for f in "${md_files[@]}"; do
    markdownlint "$f"
done
